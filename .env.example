# ========================================================
# NGALAM FIX PRO - ENVIRONMENT VARIABLES
# Semua akun admin, kasir, teknisi, dan mitra tersimpan di tabel users PostgreSQL.
# ========================================================

PORT=3000
# Opsional. Kosongkan agar URL OAuth mengikuti request host (localhost/Vercel/preview).
# APP_URL=https://domain-anda.com

# ========================================================
# POSTGRESQL / SUPABASE
# Untuk Vercel/serverless gunakan Transaction Pooler Supabase (port 6543).
# ========================================================
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
PG_SSL=true

# ========================================================
# SINGLE ADMIN ACCOUNT
# Portal admin hanya menerima akun ini. Ganti password sebelum production.
# ========================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fixprongalam2026

# ========================================================
# JWT
# Buat dengan: openssl rand -hex 48
# ========================================================
JWT_SECRET=replace-with-openssl-rand-hex-48

# ========================================================
# GOOGLE OAUTH 2.0
# Authorized redirect URI:
#   http://localhost:3000/api/customer/auth/google/callback
#   http://localhost:3000/api/mitra/auth/google/callback
# ========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional. Kosongkan agar callback otomatis mengikuti request host.
# GOOGLE_REDIRECT_URI=https://domain-anda.com/api/customer/auth/google/callback
# GOOGLE_REDIRECT_URI_MITRA=https://domain-anda.com/api/mitra/auth/google/callback

# ========================================================
# OPSIONAL: GOOGLE SPREADSHEETS INTEGRATION
# ========================================================
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
SPREADSHEET_CUSTOMERS_ID=
SHEET_NAME_CUSTOMERS=DataCustomer
SPREADSHEET_DRIVERS_ID=
SHEET_NAME_DRIVERS=MitraDriver
SPREADSHEET_WORKERS_ID=
SHEET_NAME_WORKERS=DataPekerja
SPREADSHEET_TRANSACTIONS_ID=
SHEET_NAME_TRANSACTIONS=RiwayatTransaksi
SPREADSHEET_FINANCE_ID=
SHEET_NAME_FINANCE=CatatanKeuangan
SPREADSHEET_ID=
SHEET_NAME=TiketServis
