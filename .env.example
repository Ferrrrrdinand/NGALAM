# =====================================================================
# PANDUAN KONFIGURASI ENVIRONMENT RUMAHWEB & PRODUCTION
# =====================================================================
# Rename file ini menjadi '.env' di cPanel File Manager Rumahweb

# 1. Konfigurasi Server
PORT=5000
NODE_ENV=production
JWT_SECRET=ngalam_fix_pro_secret_key_production_2026

# ---------------------------------------------------------------------
# OPSI A: Menggunakan PostgreSQL Cloud (Neon / Supabase) - [DIREKOMENDASIKAN]
# Sangat cepat, hemat RAM cPanel, gratis, dan otomatis backup.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.ap-southeast-1.aws.neon.tech/postgres?sslmode=require
PG_SSL=true

# ---------------------------------------------------------------------
# OPSI B: Menggunakan MySQL cPanel Rumahweb
# (Jika ingin menggunakan database lokal di cPanel Rumahweb)
# ---------------------------------------------------------------------
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=usernamecpanel_ngalamdb
# DB_USER=usernamecpanel_ngalamuser
# DB_PASS=password_database_anda

# 2. Base URL Website
BASE_URL=https://domainanda.com

