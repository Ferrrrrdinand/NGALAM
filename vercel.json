{
  "buildCommand": "npm run build",
  "installCommand": "npm install --no-audit --no-fund && npm --prefix client ci --no-audit --no-fund",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,data,scripts,client/dist}/**",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
