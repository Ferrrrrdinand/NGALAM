PORT=3000
ADMIN_PORT=3001
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx8WWCfIHNyqdb0zf7-WWj8cBg1DGWJaAyE2pY5nmrTN8lO2ZQEeq7FG2WCu_GV1nGXXg/exec

# KODE REFERRAL MASTER KHUSUS AKSES ADMIN KESELURUHAN (SUPER ADMIN)
ADMIN_REFERRAL_CODE=NGALAM-SUPER-2026

# ========================================================
# PENGATURAN FILE DATA PENGGUNA TERPISAH (USER DATA FILES)
# Masing-masing kelompok user memiliki file mandiri yang terhubung via ENV:
# ========================================================
USERS_ADMIN_FILE=data/users_admin.json
USERS_KASIR_FILE=data/users_kasir.json
USERS_TEKNISI_FILE=data/users_teknisi.json
USERS_MITRA_FILE=data/users_mitra.json

# ========================================================
# PENGATURAN 4 GOOGLE SPREADSHEETS (NGALAM FIX PRO)
# ========================================================
# 1. File kredensial Service Account Google Cloud (letakkan di root folder)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# 2. SPREADSHEET 1: DATA AKUN CUSTOMER
SPREADSHEET_CUSTOMERS_ID=
SHEET_NAME_CUSTOMERS=DataCustomer

# 3. SPREADSHEET 2: DATA MITRA DRIVER
SPREADSHEET_DRIVERS_ID=
SHEET_NAME_DRIVERS=MitraDriver

# 4. SPREADSHEET 3: DATA PEKERJA / TEKNISI / STAF
SPREADSHEET_WORKERS_ID=
SHEET_NAME_WORKERS=DataPekerja

# 5. SPREADSHEET 4: RIWAYAT TRANSAKSI KESELURUHAN
SPREADSHEET_TRANSACTIONS_ID=
SHEET_NAME_TRANSACTIONS=RiwayatTransaksi

# OPSIONAL: SPREADSHEET CATATAN KEUANGAN & TIKET SERVIS
SPREADSHEET_FINANCE_ID=
SHEET_NAME_FINANCE=CatatanKeuangan
SPREADSHEET_ID=
SHEET_NAME=TiketServis

# ========================================================
# INTEGRASI DATABASE KE POSTGRESQL (NGALAM FIX PRO)
# ========================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/ngalam_fix_pro
PGDATABASE=ngalam_fix_pro
PGUSER=postgres
PGPASSWORD=password
PGHOST=localhost
PGPORT=5432
